@using WebMatrix.Data

@{
    var db = Database.Open("AmazonOrders");

    if (IsPost)
    {
        var name = Request.Form["productName"];
        var category = Request.Form["categoryName"];
        var cost = Request.Form["cost"];
        var description = Request.Form["description"];
        var image = Request.Form["image"];
        var sql_insert = $"Insert into Items (itemName, itemDescription, itemCost, itemImage, categoryID) values ({name}, {cost}, {description}, {image}, {category})";
        var data = db.Execute(sql_insert);
    }

    var sql_categories = $"select sub.categoryID, concat(parentcat.categoryName, ' - ', sub.categoryName) as categoryName from itemcategories as sub join itemcategories as parentcat on sub.categoryID = parentcat.categoryID order by parentcat.categoryName, sub.categoryName";
    var cat_data = db.Query(sql_categories, "");

}

<h2 class="text-center">Create Product</h2>

<form class="row" method="post" action="/Management/Create">
    <p>Item # [auto]</p>
    <div class="mb-2">
        <div>
            <p>Name</p>
            <input type="text" name="productName" placeholder="Product Name" class="form-control" />
        </div>

        <div>
            <p>Category</p>
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Category
                </button>
                <ul class="dropdown-menu">
                    @foreach (var cat in cat_data)
                    {
                        <li><a class="dropdown-item" name="categoryName" id="@cat.categoryID">@cat.categoryName</a></li>
                    }
                </ul>
            </div>
        </div>

        <p>Unit Cost</p>
        <input type="text" name="cost" placeholder="0.00" class="form-control" />

        <p>Description</p>
        <textarea name="description" placeholder="description" class="form-control"></textarea>

        <p>Image URL</p>
        <input name="imageurl" placeholder="imageurl" class="form-control" />

        <div class="justify-content-right">
            <button class="btn btn-primary">Save</button>
            <button class="btn btn-primary">Clear</button>
        </div>

    </div>
</form>