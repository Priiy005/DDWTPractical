@using WebMatrix.Data

@{
    var db = Database.Open("AmazonOrders");

    var id = Request.QueryString["id"];

    var sql = "Select * FROM Items join itemcategories on items.categoryID = itemcategories.categoryID";

    var data = db.QuerySingle(sql, id);
}

<div>
    <h2 class="text-center bg-light">Product Details</h2>
    <div class=" row justify-content-center">
        <div class="card form-control" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">@data.itemName</h5>
                <p class="card-text">@data.itemDescription</p>
                <p class="card-subtitle mb-2 text-muted">Price: $@data.itemCost.ToString()</p>
                <p class="card-subtitle mb-2 text-muted">Category: @data.categoryName</p>
            </div>
            <img src="@data.itemImage" class="card-img-top" alt="Image of @data.itemName " />
        </div>
    </div>
</div>

