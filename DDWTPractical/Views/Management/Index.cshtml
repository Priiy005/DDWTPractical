@using WebMatrix.Data

@{
    var db = Database.Open("AmazonOrders");

    var sql = "Select * FROM Items as I join ItemCategories as IC on IC.categoryID = I.categoryID WHERE I.itemName like CONCAT(@0, '%') order by I.itemName asc";

    if (IsPost && Request.Form["delete"] != null)
    {
        var del_sql = "DELETE FROM Itemss WHERE I.ItemID = @0";
        db.QuerySingle(del_sql, Request.Form["delete"]);
    }

    var data = db.Query(sql, Request.Form["searchBar"]);
}


<h2 class="text-center bg-light">Product Management</h2>

<form class="row" method="post" action="/Management/Index">
    <div class="row mb-2">
        <div class="col-3">
            <input type="text" name="text" placeholder="Product Name" class="form-control" />
        </div>
        <div class="col-3">
            <button class="btn btn-secondary">Search</button>
            <button href="/Management/Create" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-title="Add a new item">New Item</button>
        </div>
    </div>

    @if (data.Count() > 0)
    {
<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Item #</th>
            <th scope="col">Name</th>
            <th scope="col">Category</th>
            <th scope="col">Cost ($)</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    @foreach (var row in data)
    {
        <tr>
            <td>@row.itemID</td>
            <td>@row.itemName</td>
            <td>@row.categoryName</td>
            <td>@row.itemCost</td>
            <td>
                <div>
                    <a href="/Management/Edit?id=@row.ItemID" class="btn btn-primary">Edit</a>
                    <a value="@row.ItemID" name="delete" class="btn btn-primary">Delete</a>
                </div>
            </td>
        </tr>
    }
    <tbody>
    </tbody>
</table>
    }
else
    {

    }

</form>

