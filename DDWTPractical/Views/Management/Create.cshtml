@using WebMatrix.Data

@{
    var db = Database.Open("AmazonOrders");

    if (IsPost)
    {
        var name = Request.Form["productName"];
        var category = Request.Form["categoryID"];
        var cost = Request.Form["cost"];
        var description = Request.Form["description"];
        var image = Request.Form["imageurl"];
        var sql_insert = $"Insert into Items (itemName, itemDescription, itemCost, itemImage, categoryID) values (@0, @1, @2, @3, @4); select scope_identity()";
        var data = db.QueryValue(sql_insert, name, description, cost, image, Convert.ToInt32(category));
        Response.Redirect("/Management/Edit?id=" + data);
    }

    var sql_categories = $"select sub.categoryID as catID, concat(parentcat.categoryName, ' - ', sub.categoryName) as categoryName from itemcategories as sub join itemcategories as parentcat on sub.categoryID = parentcat.categoryID order by parentcat.categoryName, sub.categoryName";
    var cat_data = db.Query(sql_categories, "");

}

<h2 class="text-center">Create Product</h2>

<form class="row" method="post" action="/Management/Create">
    <p>Item # [auto]</p>
    <div class="mb-2">
        <div>
            <p>Name</p>
            <input type="text" name="productName" placeholder="Product Name" class="form-control" />
        </div>

        <div>
            <p>Category</p>
            <select name="categoryID" class="dropdown">
                <option value="">Select Category</option>
                @foreach (var cat in cat_data)
                {
                    <option value="@cat.catID">@cat.categoryName</option>
                }
            </select>
        </div>

        <p>Unit Cost</p>
        <input type="number" name="cost" placeholder="0.00" class="form-control" />

        <p>Description</p>
        <textarea name="description" placeholder="description" class="form-control"></textarea>

        <p>Image URL</p>
        <input name="imageurl" placeholder="imageurl" class="form-control" />

        <div class="justify-content-right">
            <button class="btn btn-primary">Save</button>
            <button class="btn btn-primary">Clear</button>
        </div>

    </div>
</form>