@using WebMatrix.Data

@{
    var db = Database.Open("AmazonOrders");

    var sql = "Select * FROM Items ORDER BY itemName asc";

    var data = db.Query(sql);
}

<form class="row" method="post" uiactions="/Home/Index">
    <div class="col-3" >
        <input type="text" placeholder="Product Name" class="form-control"/>
    </div>

    <div class="col-3">
        <button class="btn btn-primary">Search</button>
    </div>
    <h2 class="text-center bg-light">All Products</h2>
</form>

    <div class="row justify-content-center">
        @foreach (var row in data)
        {
            <div class="card" style="width: 18rem;">
                <img src="@row.itemImage" class="card-img-top"  alt="Image of @row.itemName "/>
                <div class="card-body">
                    <h5 class="card-title">@row.itemName</h5>
                    <p class="card-text">@row.itemDescription</p>
                    <p class="card-text">$@row.itemCost.ToString()</p>
                    <a href="/Home/Details?id=@row.ItemID" class="btn btn-primary">Go somewhere</a>

                </div>
            </div>
        }
    </div>